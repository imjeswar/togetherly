# Togetherly Mobile Environment Variables (Expo SDK 52)

# Backend API Base URL (defaults to localhost:5000/api on iOS and 10.0.2.2:5000/api on Android)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# WebSocket Server URL
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# App Scheme for Deep Linking
EXPO_PUBLIC_APP_SCHEME=togetherly://

