# Togetherly Server Production Environment Configuration
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL or SQLite file:./dev.db)
DATABASE_URL="postgresql://togetherly_user:your_secure_password@localhost:5432/togetherly_prod?schema=public"

# JWT Secret for Session Authentication (generate using: openssl rand -base64 64)
JWT_SECRET="replace-with-high-entropy-64-character-cryptographic-secret"

# Web Client URL for CORS
CLIENT_URL="https://app.togetherly.app"

# AI Companion Configuration (OpenAI-compatible)
OPENAI_API_KEY="your-openai-api-key"
AI_PROVIDER="openai" # or "local"

